# --- Base de datos ---
# Local (docker compose up db  +  npm run dev):
DATABASE_URL=postgres://prodiva:prodiva@localhost:5433/prodiva
# Vercel: pega aquí la cadena "pooled" de Neon (o la que te dé tu Postgres)

# --- Panel de administración (/admin) ---
ADMIN_PASSWORD=pon-una-contraseña-larga
# openssl rand -hex 32
SESSION_SECRET=

# --- Reglas del salón ---
SALON_TIMEZONE=Europe/Madrid
SLOT_STEP_MIN=15
MIN_NOTICE_MIN=120
MAX_DAYS_AHEAD=60
HOLD_MINUTES=10
CANCEL_NOTICE_HOURS=24
# Número de WhatsApp en formato internacional, sin + (España = 34)
WHATSAPP_NUMBER=34670424348

# --- Emails (opcional, Resend) ---
OWNER_EMAIL=
RESEND_API_KEY=
MAIL_FROM=Pro Diva <reservas@tudominio.com>

# --- Hero animado (nº de fotogramas en public/frames) ---
NEXT_PUBLIC_HERO_FRAMES=90

# --- Blindaje y crecimiento ---
# Verificación del teléfono con código: off | new (solo números nuevos, por defecto) | all
PHONE_VERIFY=new
# Local sin Twilio/WhatsApp: los mensajes se ven en /admin/bandeja y el código sale en pantalla. NO en producción.
DEMO_MODE=
# Solo para las pruebas automáticas (se ignora en producción real)
DISABLE_RATE_LIMITS=
# Plantillas de WhatsApp (categoría Utilidad / Marketing) para los mensajes nuevos
WA_TEMPLATE_OTP=
WA_TEMPLATE_ABANDON=
WA_TEMPLATE_REACTIVATE=
# Cron (GitHub Actions o tu servicio): mismo valor en Vercel y en los secretos del repositorio
CRON_SECRET=
# Compara cada cálculo de huecos con el método antiguo y anota diferencias en audit_log (solo para verificar; añade carga)
AVAILABILITY_SHADOW=
